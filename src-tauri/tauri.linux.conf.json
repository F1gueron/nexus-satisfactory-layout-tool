{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Satisfactory Layout Tool",
  "version": "2.0.0",
  "identifier": "com.satisfactory-layout-tool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Satisfactory Layout Tool",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/applications/satisfactory-layout-tool.desktop": "./linux/satisfactory-layout-tool.desktop",
          "/usr/share/icons/hicolor/128x128/apps/satisfactory-layout-tool.png": "./icons/128x128.png"
        }
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "depends": [
          "gtk3",
          "webkit2gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "dialog": null,
    "os": {}
  }
}