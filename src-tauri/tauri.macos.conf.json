{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Satisfactory Layout Tool",
  "version": "2.0.0",
  "identifier": "com.satisfactory-layout-tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Satisfactory Layout Tool",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "copyright": "Copyright (C) 2026 Austin Handle. AGPL-3.0-or-later.",
    "category": "Productivity",
    "shortDescription": "Multi-floor factory layout planner for Satisfactory",
    "longDescription": "A high-performance, multi-floor factory layout planner for Satisfactory. Plan conveyors, pipes, railways, powerlines and foundations on a fast 2D canvas backed by a native Rust core, with a full production simulation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "providerShortName": null,
      "signingIdentity": null,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "dialog": null,
    "os": {},
    "updater": {
      "endpoints": [
        "https://github.com/HandleConsolidated/nexus-satisfactory-layout-tool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QjEyMTc3QjgwMzIwREUKUldUZUlBTzRkeUd4NllrZFhEZVhKSnBCc3kvRVdFZTZWaGIva3UrZlpBdVpBaWZESWplUWFyd0EK"
    }
  }
}
