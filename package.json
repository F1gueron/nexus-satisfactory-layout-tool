{
  "name": "satisfactory-layout-tool",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Austin Handle",
    "url": "https://x.com/Officer_ASH"
  },
  "homepage": "https://github.com/HandleConsolidated/nexus-satisfactory-layout-tool",
  "scripts": {
    "dev": "npm run dev:full",
    "dev:frontend-only": "vite",
    "dev:browser": "npm run dev:full:browser",
    "dev:full": "concurrently --kill-others --names \"RUST,VITE\" --prefix-colors \"yellow,cyan\" \"npm run rust:dev\" \"npm run dev:wait-and-start\"",
    "dev:full:browser": "concurrently --kill-others --names \"RUST,VITE\" --prefix-colors \"yellow,cyan\" \"npm run rust:dev\" \"npm run dev:wait-and-start:browser\"",
    "dev:wait-and-start": "wait-on http://127.0.0.1:5175/health --timeout 120000 --log && vite",
    "dev:wait-and-start:browser": "wait-on http://127.0.0.1:5175/health --timeout 120000 --log && vite --open",
    "build": "vite build",
    "build:typecheck": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json",
    "tauri:build:macos": "tauri build --config src-tauri/tauri.macos.conf.json",
    "tauri:build:macos:universal": "tauri build --config src-tauri/tauri.macos.conf.json --target universal-apple-darwin",
    "tauri:build:appstore": "tauri build --config src-tauri/tauri.appstore.conf.json --target universal-apple-darwin --no-default-features --features appstore-mode",
    "macos:appstore": "bash scripts/build-macos-appstore.sh",
    "tauri:build:linux": "tauri build --config src-tauri/tauri.linux.conf.json",
    "build:all": "node scripts/build-all-platforms.js",
    "clean": "rimraf dist src-tauri/target",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "rust:build": "cd src-tauri && cargo build --release --bin standalone-server --features standalone --no-default-features",
    "rust:dev": "cd src-tauri && cargo run --bin standalone-server --features standalone --no-default-features",
    "rust:release": "cd src-tauri && cargo run --release --bin standalone-server --features standalone --no-default-features",
    "build:standalone": "npm run build && npm run rust:build",
    "add-release": "node scripts/add-release.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.3.2",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-os": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.6",
    "js-sha256": "^0.11.0",
    "konva": "^9.3.20",
    "lucide-react": "^0.515.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.6",
    "uuid": "^9.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tauri-apps/cli": "^2.7.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "@webgpu/types": "^0.1.68",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "glob": "^10.0.0",
    "globals": "^15.9.0",
    "javascript-obfuscator": "^5.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.45",
    "rimraf": "^5.0.0",
    "rollup-plugin-obfuscator": "^1.1.0",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^1.2.0",
    "wait-on": "^9.0.1"
  }
}
